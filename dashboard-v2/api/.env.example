# Paste the complete service-account JSON as one environment-variable value.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_NAME=Mob Price Monitor
PRICING_CACHE_TTL_SECONDS=900
PRICING_INITIAL_LOAD_TIMEOUT_SECONDS=12

# Comma-separated exact frontend origins. Do not include paths or trailing slashes.
FRONTEND_ORIGINS=https://your-dashboard.vercel.app
